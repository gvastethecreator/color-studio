{
  "name": "color-studio",
  "version": "0.2.0",
  "description": "Local-first color workbench for harmony palettes, CSS gradients, OKLCH scales, contrast testing, mixing, and export.",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "node scripts/run-with-log.mjs check vp check",
    "check:fix": "node scripts/run-with-log.mjs check-fix vp check --fix",
    "lint": "node scripts/run-with-log.mjs lint vp lint",
    "fmt": "node scripts/run-with-log.mjs fmt vp fmt",
    "test": "node scripts/run-with-log.mjs test vp test --run --coverage --reporter=verbose",
    "build": "node scripts/run-with-log.mjs build vp build",
    "preview": "vp preview",
    "clean": "node scripts/clean-generated.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "catalog:",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "^0.2.9",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
